concurrent = {{ gitlab_runner_concurrent }}
check_interval = 0
shutdown_timeout = 0

[session_server]
  session_timeout = 1800

[[runners]]
  name = "{{ gitlab_runner_name }}"
  url = "{{ gitlab_runner_url }}"
  token = "{{ gitlab_runner_token }}"
  executor = "{{ gitlab_runner_executor }}"
  request_concurrency = {{ gitlab_runner_concurrent }}
  output_limit = 4194304
{% if gitlab_runner_ca_fetch %}
  tls-ca-file = "{{ gitlab_runner_certs_dir }}/ca.crt"
{% endif %}

  [runners.cache]
    MaxUploadedArchiveSize = 0
{% if gitlab_runner_executor == "docker" %}

  [runners.docker]
    image = "{{ gitlab_runner_docker_image }}"
    privileged = true
    tls_verify = false
    disable_cache = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    pull_policy = ["if-not-present"]
    shm_size = 0
    volumes = {{ gitlab_runner_docker_volumes | to_json }}
{% endif %}
