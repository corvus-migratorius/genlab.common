external_url "https://{{ gitlab_ce_fqdn }}"

letsencrypt['enable'] = false

nginx['redirect_http_to_https'] = true
nginx['ssl_certificate'] = "{{ gitlab_ce_ssl_dir }}/{{ gitlab_ce_fqdn }}.crt"
nginx['ssl_certificate_key'] = "{{ gitlab_ce_ssl_dir }}/{{ gitlab_ce_fqdn }}.key"

registry['enable'] = false
gitlab_pages['enable'] = false
gitlab_kas['enable'] = false

prometheus['enable'] = false
alertmanager['enable'] = false

puma['worker_processes'] = {{ gitlab_ce_puma_workers }}
sidekiq['concurrency'] = {{ gitlab_ce_sidekiq_concurrency }}

{% if gitlab_ce_smtp_username is defined and gitlab_ce_smtp_password is defined %}
gitlab_rails['smtp_enable'] = true
gitlab_rails['smtp_address'] = "{{ gitlab_ce_smtp_address }}"
gitlab_rails['smtp_port'] = {{ gitlab_ce_smtp_port }}
gitlab_rails['smtp_user_name'] = "{{ gitlab_ce_smtp_username }}"
gitlab_rails['smtp_password'] = "{{ gitlab_ce_smtp_password }}"
gitlab_rails['smtp_domain'] = "{{ gitlab_ce_smtp_domain }}"
gitlab_rails['smtp_authentication'] = "{{ gitlab_ce_smtp_authentication }}"
gitlab_rails['smtp_enable_starttls_auto'] = {{ gitlab_ce_smtp_enable_starttls_auto | bool | lower }}
gitlab_rails['smtp_tls'] = {{ gitlab_ce_smtp_tls | bool | lower }}
gitlab_rails['smtp_pool'] = {{ gitlab_ce_smtp_pool | bool | lower }}

gitlab_rails['smtp_openssl_verify_mode'] = '{{ gitlab_ce_smtp_openssl_verify_mode }}'

gitlab_rails['gitlab_email_from'] = "{{ gitlab_ce_email_from }}"
gitlab_rails['gitlab_email_display_name'] = '{{ gitlab_ce_email_display_name }}'
gitlab_rails['gitlab_email_reply_to'] = "{{ gitlab_ce_email_reply_to }}"
{% endif %}